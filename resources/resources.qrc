<RCC>
  <qresource prefix="/icons">
    <file alias="photoprint.png">photoprint-256.png</file>
  </qresource>
  <qresource prefix="/effects">
    <file alias="catalogue.json">effects/catalogue.json</file>
  </qresource>
  <qresource prefix="/templates">
    <file alias="collage.json">templates/collage.json</file>
  </qresource>
  <qresource prefix="/textures">
    <file alias="paper-fine.png">textures/paper-fine.png</file>
    <file alias="paper-news.png">textures/paper-news.png</file>
    <file alias="paper-soft.png">textures/paper-soft.png</file>
    <file alias="paper-wash.png">textures/paper-wash.png</file>
    <file alias="dust-fine.png">textures/dust-fine.png</file>
  </qresource>
  <qresource prefix="/samples">
    <file alias="effect-sample.jpg">samples/effect-sample.jpg</file>
  </qresource>
  <qresource prefix="/stickers">
    <file alias="star.png">stickers/star.png</file>
    <file alias="heart.png">stickers/heart.png</file>
    <file alias="arrow.png">stickers/arrow.png</file>
    <file alias="speech.png">stickers/speech.png</file>
    <file alias="sun.png">stickers/sun.png</file>
    <file alias="flower.png">stickers/flower.png</file>
    <file alias="confetti.png">stickers/confetti.png</file>
    <file alias="frame.png">stickers/frame.png</file>
    <file alias="ring.png">stickers/ring.png</file>
    <file alias="sparkle.png">stickers/sparkle.png</file>
    <file alias="ribbon.png">stickers/ribbon.png</file>
    <file alias="badge.png">stickers/badge.png</file>
  </qresource>
</RCC>
