# Maintainer: Laszlo Toth <lavx@lavx.hu>
# Build the released tag from its Git sources:
#   makepkg -si
pkgname=photoprint
pkgver=1.2.2
pkgrel=1
pkgdesc="Arrange, crop and print photos on paper"
arch=('x86_64' 'aarch64')
url="https://github.com/LavX/PhotoPrint"
license=('MIT')
depends=('gcc-libs' 'qt6-base' 'lcms2' 'libcups' 'imagemagick' 'zlib')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
source=("${pkgname}::git+https://github.com/LavX/PhotoPrint.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cmake -S "${pkgname}" -B "${pkgname}/build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "${pkgname}/build"
}

package() {
  cd "${pkgname}"
  install -Dm755 build/photoprint "${pkgdir}/usr/bin/photoprint"
  install -Dm644 resources/photoprint.desktop \
    "${pkgdir}/usr/share/applications/photoprint.desktop"
  install -Dm644 resources/photoprint.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/photoprint.svg"
  install -Dm644 resources/photoprint-256.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/photoprint.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
