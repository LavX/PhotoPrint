# Build output
/build/
*.o
*.rpm

# Editor and tool state
*.user

# Local environment files, anywhere in the tree; a committed template such as
# .env.example stays tracked
.env*
!.env.example

# Compiled shared libraries and their Windows/macOS equivalents
*.so
*.so.*
*.dll
*.dylib

# Generated documents and images; bundled and fixture PNGs stay tracked
*.pdf
*.png
!/resources/**/*.png
!/tests/fixtures/**/*.png

# Local planning material
/docs/
/planning/
/planning-initial/
